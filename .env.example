# Application
APP_NAME=Seller Toolkit
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key
DOMAIN=sisuu.com

# Database (local Laragon — adjust for your environment)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sisuu_tools

# Docker Compose — MySQL container credentials
MYSQL_ROOT_PASSWORD=sisuu_root
MYSQL_DATABASE=sisuu_tools

# DeepSeek AI (do not hardcode in source code)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# Admin (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Analytics — Google Analytics 4 (leave empty to disable)
GA_MEASUREMENT_ID=

# Payment provider (stub | paypal | stripe — 推荐 paypal，无需 Stripe)
PAYMENT_PROVIDER=stub

# PayPal（推荐 — 全球卖家常用，见 docs/15-支付方案.md）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_BUSINESS=
PAYPAL_WEBHOOK_ID=

# Stripe（可选，有账户才配）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Usage limits (AI tools per day)
GUEST_AI_DAILY_LIMIT=3
REGISTERED_AI_DAILY_LIMIT=10
